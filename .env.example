MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=finbynmart
# long random string used to sign session cookies
AUTH_SECRET=
# private directory (outside public/) holding certificate files served by /api/public/certifications/<id>/document
# CERTIFICATE_DOCS_DIR=

# Private directory for buyers' company documents (outside public/). Optional in development (.data/buyer-docs is used); REQUIRED in production, where uploads are refused without it.
# BUYER_DOCS_DIR=

# Buyer support (Page 36). All optional: a channel is shown only when it is set. Never put real values in this file.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
# Ticket attachment limits (defaults: 5 files, 10 MB each; ceilings 10 files, 25 MB)
SUPPORT_ATTACH_MAX_FILES=
SUPPORT_ATTACH_MAX_MB=
