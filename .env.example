MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=finbynmart
# long random string used to sign session cookies
AUTH_SECRET=
# private directory (outside public/) holding certificate files served by /api/public/certifications/<id>/document
# CERTIFICATE_DOCS_DIR=

# Private directory for buyers' company documents (outside public/). Optional in development (.data/buyer-docs is used); REQUIRED in production, where uploads are refused without it.
# BUYER_DOCS_DIR=

# Buyer support (Page 36). All optional: a channel is shown only when it is set. Never put real values in this file.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
# Ticket attachment limits (defaults: 5 files, 10 MB each; ceilings 10 files, 25 MB)
SUPPORT_ATTACH_MAX_FILES=
SUPPORT_ATTACH_MAX_MB=

# ImageKit (supplier product images). The private key is server-only: never prefix it with NEXT_PUBLIC_.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Quotation tax treatments (JSON array). EMPTY by default: drafts work but quotation submission stays blocked until the business approves treatments.
# No rate is built into the code. Format (an example of the SHAPE only, not an approved rate):
#   [{"id":"<id>","version":"<version>","label":"<label>","kind":"RATE","ratePercent":"<0-100>"},{"id":"<id>","version":"<v>","label":"<label>","kind":"EXEMPT"}]
QUOTATION_TAX_RULES=

# Lead-distribution worker (POST /api/internal/distribution, Authorization: Bearer <secret>). At least 24 random characters. EMPTY = the endpoint is off (503).
# A scheduler must call it (for example every minute); none is deployed by this repository.
DISTRIBUTION_WORKER_SECRET=
